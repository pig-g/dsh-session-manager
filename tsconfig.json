{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "sourceMap": false,
    "paths": {
      "@deepseek-ai/dsh-session": ["./../deepseek-harness/packages/core/session/lib/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
